{
  "manifest_version": 3,
  "name": "Open Video Downloader (Save As)",
  "short_name": "OVD Save As",
  "version": "1.1.0",
  "description": "Download the video you're watching with the Open Video Downloader (Save As) app: pick the format, pick where to save, open the file.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Video Downloader",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "contextMenus", "notifications", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "commands": {
    "download-video": {
      "description": "Download the video on this page"
    }
  }
}
